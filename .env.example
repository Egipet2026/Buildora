# ---------------------------------------------------------------------------
# Buildora environment
# ---------------------------------------------------------------------------
# The app runs in DEMO MODE (in-memory seed data, no writes persisted) whenever
# the two public Supabase variables below are missing. Fill them in to switch
# the whole data layer over to a real Supabase project.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by admin tooling / scripted seeding. NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Sending the 6-digit confirmation code
# ---------------------------------------------------------------------------
# Without one of these the code CANNOT leave the server, so it is shown on
# screen instead and labelled as undelivered. Set one to send it for real.
#
# Email — either a Resend API key (simplest, no dependency) …
RESEND_API_KEY=
# … or any SMTP server (Gmail, Fastmail, Postmark, your own host).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The From address. With Resend it must be on a domain you verified there.
EMAIL_FROM=Buildora <onboarding@resend.dev>

# SMS — Twilio. Set either TWILIO_FROM or TWILIO_MESSAGING_SERVICE_SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# ---------------------------------------------------------------------------
# Payments (optional)
#
# Without these the site still works: a sale is recorded and no money moves,
# and every button that would charge says so instead of pretending.
#
# STRIPE_WEBHOOK_SECRET comes from the endpoint you create in the Stripe
# dashboard pointing at https://your-site/api/stripe/webhook. Nothing paid for
# is ever granted without it, because Stripe's signed confirmation is the only
# thing this app believes about a payment.
#
# SUPABASE_SERVICE_ROLE_KEY lets the webhook write past row-level security —
# it has no signed-in user to act as. It bypasses every access rule, so it must
# never be committed and must never be given a NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
