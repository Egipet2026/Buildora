# ---------------------------------------------------------------------------
# BizHub environment
# ---------------------------------------------------------------------------
# The app runs in DEMO MODE (in-memory seed data, no writes persisted) whenever
# the two public Supabase variables below are missing. Fill them in to switch
# the whole data layer over to a real Supabase project.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by admin tooling / scripted seeding. NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: enables the real AI business-plan generator on /start-a-business.
# Without it the planner falls back to a deterministic local template.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Sending the 6-digit confirmation code
# ---------------------------------------------------------------------------
# Without one of these the code CANNOT leave the server, so it is shown on
# screen instead and labelled as undelivered. Set one to send it for real.
#
# Email — either a Resend API key (simplest, no dependency) …
RESEND_API_KEY=
# … or any SMTP server (Gmail, Fastmail, Postmark, your own host).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The From address. With Resend it must be on a domain you verified there.
EMAIL_FROM=Bizora <onboarding@resend.dev>

# SMS — Twilio. Set either TWILIO_FROM or TWILIO_MESSAGING_SERVICE_SID.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
